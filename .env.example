# Copia in .env (non committare .env). Nessun segreto in questo file.
# Token di accesso: OBBLIGATORIO per ./start.sh --lan (iPad sulla stessa rete)
MODEL3D_TOKEN=
# Meshy (servizio remoto a crediti, piano con API): la chiave resta sul server
MESHY_API_KEY=
# TRELLIS.2 in locale (PC con GPU NVIDIA 24 GB, Linux). Prepara con: bash server/tools/trellis2_setup.sh
TRELLIS2_DIR=/home/USER/TRELLIS.2
MODEL3D_LOCAL_CMD=bash -lc 'eval "$(conda shell.bash hook)" && conda activate trellis2 && python /home/USER/TRELLIS.2/model3d_worker.py --image {image} --out {out}'
MODEL3D_LOCAL_TIMEOUT=3600
# 0 = nasconde il manichino di prova dall'elenco dei motori
MODEL3D_ENABLE_FIXTURE=1
# MODEL3D_DATA=/percorso/dati
