# Copia in .env (non committare .env). Nessun segreto in questo file.
# Token di accesso: OBBLIGATORIO per ./start.sh --lan (iPad sulla stessa rete)
MODEL3D_TOKEN=
# Meshy (servizio remoto a crediti): la chiave resta sul server, mai nel browser
MESHY_API_KEY=
# Motore locale/remoto via comando (vedi server/tools/trellis2_worker.py)
MODEL3D_LOCAL_CMD=
MODEL3D_LOCAL_TIMEOUT=3600
# 0 = nasconde il manichino di prova dall'elenco dei motori
MODEL3D_ENABLE_FIXTURE=1
# MODEL3D_DATA=/percorso/dati
